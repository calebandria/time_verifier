{
  "name": "time_verifier",
  "version": "1.0.0",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "concurrently \"yarn --cwd server dev\" \"yarn --cwd client dev\"",
    "dev:server": "yarn --cwd server dev",
    "dev:client": "yarn --cwd client dev",
    "start": "yarn --cwd server start",
    "install:all": "yarn install && yarn --cwd server install && yarn --cwd client install",
    "typecheck": "yarn --cwd server typecheck && yarn --cwd client typecheck"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}


